# Application
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Database
DATABASE_URL=postgresql://salmonz:salmonz@localhost:5432/salmonz?schema=public

# JWT (required — must be non-empty)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=salmonz
S3_PUBLIC_BASE_URL=http://localhost:9000/salmonz
S3_FORCE_PATH_STYLE=true

# Seed users (required for admin seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeAdmin123!
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=ChangeMeDemo123!
