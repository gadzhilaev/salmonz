# Application
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://10.0.2.2:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/salmonz?schema=public

# JWT (required — non-empty)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Storage: local (filesystem) or s3 (MinIO/AWS/etc.)
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
PUBLIC_MEDIA_BASE_URL=http://localhost:3000/media

# S3 / MinIO (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=salmonz
S3_PUBLIC_BASE_URL=http://localhost:9000/salmonz
S3_FORCE_PATH_STYLE=true

# Seed users
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeAdmin123!
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=ChangeMeDemo123!
