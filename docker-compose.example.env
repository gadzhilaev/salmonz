# Copy to docker-compose `.env` next to this file, or export these vars.
POSTGRES_USER=salmonz
POSTGRES_PASSWORD=salmonz
POSTGRES_DB=salmonz
POSTGRES_PORT=5432

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=salmonz
S3_PUBLIC_BASE_URL=http://localhost:9000/salmonz
S3_REGION=us-east-1
# Compose backend defaults to MinIO (s3). Use local for host-run Nest only.
STORAGE_DRIVER=s3

JWT_ACCESS_SECRET=change-me-docker-access-secret-min-32
JWT_REFRESH_SECRET=change-me-docker-refresh-secret-min-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

CORS_ORIGINS=http://localhost:3000,http://localhost:8080
BACKEND_PORT=3000

# Seeded on container start (demo only — change before any shared env)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeAdmin123!
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=ChangeMeDemo123!
RUN_SEED_ON_START=true
